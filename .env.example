# SecureLens Environment Configuration
# Copy this file to .env.local to configure your custom environment

# Application Settings
NEXT_PUBLIC_APP_NAME=SecureLens
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_TAGLINE="See the Risk. Fix the Risk."

# Supabase Public Keys (Optional - Application functions fully in Autonomous Demo & Client mode without keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-Side Only Secrets (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OPENAI_API_KEY=your-openai-key-or-groq-key
# ENCRYPTION_KEY=your-32-char-encryption-key
